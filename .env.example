# Copy to .env and adjust if needed. These are LOCAL DEVELOPMENT defaults only —
# real credentials must never be committed (see .gitignore).

MYSQL_DATABASE=garage
MYSQL_USER=garage
MYSQL_PASSWORD=garage
MYSQL_ROOT_PASSWORD=root-local-only

# Where the application reaches the simulator's GET /garage
# (simulator actually listens on :3000 — see docs/specs/00-challenge-analysis.md)
GARAGE_SIMULATOR_BASE_URL=http://host.docker.internal:3000

# Business timezone used to resolve the calendar date of /revenue queries
GARAGE_BUSINESS_ZONE=America/Sao_Paulo
